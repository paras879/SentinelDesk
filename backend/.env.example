PORT=8080

APP_NAME=SentinelDesk
APP_VERSION=1.0.0
APP_ENV=development

# SaaS Plan & Licensing (Set 0 for Unlimited)
MAX_DEVICES=3
PLAN_NAME=Starter

# Neon Cloud Database or Local PostgreSQL
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=sentineldesk
DB_SSLMODE=disable

JWT_SECRET=SentinelDeskSuperSecretKey123456789
AGENT_API_KEY=SentinelDeskAgentKey123456

# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# Redis Pub/Sub for horizontal scaling (Optional - defaults to in-memory hub)
# REDIS_URL=redis://localhost:6379
